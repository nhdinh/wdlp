# Production server configuration. Values are intentionally omitted.
# Configure hostname LDAPS URLs (not IP literals) so TLS hostname verification remains enabled.
DLP_AD_PRIMARY_LDAPS_URL=
DLP_AD_SECONDARY_LDAPS_URL=
DLP_AD_BIND_DN=
DLP_AD_BIND_PASSWORD=
DLP_AD_CA_CERT_PEM=

# The root is public-only. Never configure, mount, or supply a root private key.
DLP_PHASE1_ROOT_CA_CERT_PEM=
DLP_DEVICE_ISSUING_CA_CERT_PEM=
# Owner-readable server secret mounted outside the container image.
DLP_DEVICE_ISSUING_CA_KEY_PEM=

# Administrator provisioning API authentication material. Mount from the secret store;
# dlpctl never receives a database credential.
DLP_ADMIN_PROVISIONING_KEY=

# Provisioning uses Kerberos WinRM-over-HTTPS from a designated domain-admin station.
# It submits only a v1 SHA-256 digest of SMBIOS UUID, BIOS serial, and OS-disk serial;
# it never accepts MAC addresses or free-form serial arguments.
# This is exact-match detection, not TPM-backed remote attestation. A privileged local
# attacker can falsify CIM observations and remains an explicit residual risk.
# DLP_LAB_ALLOW_VIRTUAL_DISK_UNIQUE_ID is intentionally omitted: set it only in a disposable
# Hyper-V lab when Win32_DiskDrive.SerialNumber is absent. MSFT_Disk.UniqueId is development
# evidence, never production authority or hardware attestation.
