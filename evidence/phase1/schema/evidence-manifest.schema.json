{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleakprevention.example/schema/phase1-evidence/v1",
  "title": "Phase 1 evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "requirement_id", "check_id", "status", "observed_utc", "clock_offset_seconds", "commit_id", "target_machine", "target_role", "procedure_version", "identity", "environment_fingerprint", "expected_result", "actual_result", "verification_tier", "substitute", "deviation", "raw_artifacts", "retention", "redaction_scan", "self_contained"],
  "properties": {
    "schema_version": {"const": "phase1-evidence/v1"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "requirement_id": {"type": "string", "pattern": "^(WRK|SRV|CRY|AGT|DRV|TST)-[0-9]{2}$"},
    "check_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "blocked"]},
    "observed_utc": {"type": "string", "format": "date-time"},
    "clock_offset_seconds": {"type": "number"},
    "commit_id": {"type": "string", "minLength": 7},
    "target_machine": {"enum": ["hungdinh-lt", "LAB-SERVER01", "LAB-DC01", "LAB-DC02", "LAB-CLIENT01"]},
    "target_role": {"enum": ["developer_orchestrator", "database_server", "primary_directory_server", "secondary_directory_server", "endpoint_runtime"]},
    "procedure_version": {"type": "string", "minLength": 1},
    "identity": {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"enum": ["automation", "authenticated_domain_operator", "independent_verifier"]}, "name": {"type": "string", "minLength": 1}}},
    "environment_fingerprint": {"type": "object", "additionalProperties": false, "required": ["machine_identity", "role", "os_build", "dependency_versions", "service_config_digest", "test_tool_versions", "domain_network_identity", "baseline_id", "binary_hashes"], "properties": {"machine_identity": {"type": "string"}, "role": {"type": "string"}, "os_build": {"type": "string"}, "dependency_versions": {"type": "object"}, "service_config_digest": {"type": "string"}, "test_tool_versions": {"type": "object"}, "domain_network_identity": {"type": "string"}, "baseline_id": {"type": "string"}, "binary_hashes": {"type": "object"}}},
    "expected_result": {"type": "string", "minLength": 1},
    "actual_result": {"type": "string", "minLength": 1},
    "verification_tier": {"enum": ["portable_automation", "focused_hyperv", "signed_visual_checklist", "phase_exit_review"]},
    "substitute": {"type": "string"},
    "deviation": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"enum": ["none", "recorded", "independently_accepted"]}, "description": {"type": "string"}}},
    "prior_attempt_id": {"type": "string", "format": "uuid"},
    "remediation_commit": {"type": "string"},
    "supersedes_evidence_id": {"type": "string", "format": "uuid"},
    "raw_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256", "accessible"], "properties": {"uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "accessible": {"type": "boolean"}}}},
    "retention": {"type": "object", "additionalProperties": false, "required": ["deadline_utc", "hold", "state"], "properties": {"deadline_utc": {"type": "string", "format": "date-time"}, "hold": {"type": "boolean"}, "state": {"enum": ["retained", "held", "eligible_for_secure_deletion"]}}},
    "redaction_scan": {"enum": ["passed"]},
    "self_contained": {"type": "boolean"},
    "dependency_digests": {"type": "object"}
  }
}
